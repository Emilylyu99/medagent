APP_ENV=development
KNOWLEDGE_BASE_PATH=data/guidelines.json
EVALUATION_CASES_PATH=data/evaluation_cases.json
API_BASE_URL=http://api:8000
REASONER_MODE=extractive
PIPELINE_MODE=baseline
# Optional: PIPELINE_MODE=adaptive with REASONER_MODE=openai enables bounded planning,
# supplementary local retrieval, semantic verification, and one repair attempt.
# To enable the model-backed reasoner, set REASONER_MODE=openai and provide both values below.
OPENAI_MODEL=
OPENAI_API_KEY=
